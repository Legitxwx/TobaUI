--[[====================================================
    LEFT TABS UI LIBRARY - ULTIMATE
    Full Features • Organized • Config Ready
====================================================]]

local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")

local UILib = {}
UILib.Flags = {}
UILib.Theme = {
    Background = Color3.fromRGB(22,22,22),
    Topbar = Color3.fromRGB(32,32,32),
    Tabs = Color3.fromRGB(28,28,28),
    Element = Color3.fromRGB(40,40,40),
    Accent = Color3.fromRGB(120,120,255),
    Text = Color3.fromRGB(255,255,255),
    SubText = Color3.fromRGB(200,200,200)
}

--====================================================
-- CONFIG SYSTEM
--====================================================
function UILib:SaveConfig(name)
    if writefile then
        writefile(name .. ".json", HttpService:JSONEncode(self.Flags))
    end
end

function UILib:LoadConfig(name)
    if readfile and isfile(name .. ".json") then
        local data = HttpService:JSONDecode(readfile(name .. ".json"))
        for k,v in pairs(data) do
            if self.Flags[k] ~= nil then
                self.Flags[k] = v
            end
        end
    end
end

--====================================================
-- WINDOW
--====================================================
function UILib:CreateWindow(cfg)
    local TitleText = cfg.Title or "UI Window"
    local ToggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift

    local ScreenGui = Instance.new("ScreenGui", CoreGui)
    ScreenGui.ResetOnSpawn = false

    local Main = Instance.new("Frame", ScreenGui)
    Main.Size = UDim2.fromOffset(700, 460)
    Main.Position = UDim2.fromScale(0.5,0.5)
    Main.AnchorPoint = Vector2.new(0.5,0.5)
    Main.BackgroundColor3 = self.Theme.Background
    Main.BorderSizePixel = 0
    Instance.new("UICorner", Main).CornerRadius = UDim.new(0,12)

    -- TOPBAR
    local Topbar = Instance.new("Frame", Main)
    Topbar.Size = UDim2.new(1,0,0,45)
    Topbar.BackgroundColor3 = self.Theme.Topbar
    Instance.new("UICorner", Topbar).CornerRadius = UDim.new(0,12)

    local Title = Instance.new("TextLabel", Topbar)
    Title.Size = UDim2.new(1,-20,1,0)
    Title.Position = UDim2.fromOffset(10,0)
    Title.BackgroundTransparency = 1
    Title.TextXAlignment = Left
    Title.Text = TitleText
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 14
    Title.TextColor3 = self.Theme.Text

    -- DRAG
    do
        local dragging, startPos, dragStart
        Topbar.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                dragStart = i.Position
                startPos = Main.Position
            end
        end)
        UIS.InputChanged:Connect(function(i)
            if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                local delta = i.Position - dragStart
                Main.Position = startPos + UDim2.fromOffset(delta.X, delta.Y)
            end
        end)
        UIS.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end)
    end

    -- HIDE / SHOW
    local visible = true
    UIS.InputBegan:Connect(function(i,gp)
        if not gp and i.KeyCode == ToggleKey then
            visible = not visible
            TweenService:Create(Main, TweenInfo.new(0.25), {
                Position = visible and UDim2.fromScale(0.5,0.5) or UDim2.fromScale(0.5,1.5)
            }):Play()
        end
    end)

    -- TABS
    local Tabs = Instance.new("Frame", Main)
    Tabs.Position = UDim2.fromOffset(10,55)
    Tabs.Size = UDim2.fromOffset(180,390)
    Tabs.BackgroundColor3 = self.Theme.Tabs
    Instance.new("UICorner", Tabs)

    local TabsLayout = Instance.new("UIListLayout", Tabs)
    TabsLayout.Padding = UDim.new(0,6)

    -- PAGES
    local Pages = Instance.new("Frame", Main)
    Pages.Position = UDim2.fromOffset(200,55)
    Pages.Size = UDim2.fromOffset(480,390)
    Pages.BackgroundTransparency = 1

    local CurrentPage
    local Window = {}

--====================================================
-- TAB
--====================================================
    function Window:CreateTab(cfg)
        local TabName = cfg.Name or "Tab"

        local TabBtn = Instance.new("TextButton", Tabs)
        TabBtn.Size = UDim2.new(1,-10,0,38)
        TabBtn.Position = UDim2.fromOffset(5,0)
        TabBtn.Text = TabName
        TabBtn.Font = Enum.Font.Gotham
        TabBtn.TextSize = 13
        TabBtn.TextColor3 = UILib.Theme.Text
        TabBtn.BackgroundColor3 = UILib.Theme.Element
        Instance.new("UICorner", TabBtn)

        local Page = Instance.new("ScrollingFrame", Pages)
        Page.Size = UDim2.new(1,0,1,0)
        Page.ScrollBarImageTransparency = 1
        Page.Visible = false

        local Layout = Instance.new("UIListLayout", Page)
        Layout.Padding = UDim.new(0,8)
        Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            Page.CanvasSize = UDim2.new(0,0,0,Layout.AbsoluteContentSize.Y + 10)
        end)

        TabBtn.MouseButton1Click:Connect(function()
            if CurrentPage then CurrentPage.Visible = false end
            Page.Visible = true
            CurrentPage = Page
        end)

        if not CurrentPage then
            Page.Visible = true
            CurrentPage = Page
        end

        local Tab = {}

--====================================================
-- ELEMENTS (WITH FLAGS)
--====================================================
        function Tab:AddToggle(cfg)
            UILib.Flags[cfg.Flag] = cfg.Default or false

            local T = Instance.new("TextButton", Page)
            T.Size = UDim2.new(1,-10,0,38)
            T.BackgroundColor3 = UILib.Theme.Element
            T.Font = Enum.Font.Gotham
            T.TextSize = 13
            T.TextColor3 = UILib.Theme.Text
            Instance.new("UICorner", T)

            local function refresh()
                T.Text = cfg.Text .. ": " .. (UILib.Flags[cfg.Flag] and "ON" or "OFF")
            end
            refresh()

            T.MouseButton1Click:Connect(function()
                UILib.Flags[cfg.Flag] = not UILib.Flags[cfg.Flag]
                refresh()
                if cfg.Callback then cfg.Callback(UILib.Flags[cfg.Flag]) end
            end)
        end

        function Tab:AddSlider(cfg)
            UILib.Flags[cfg.Flag] = cfg.Default or cfg.Min

            local Frame = Instance.new("Frame", Page)
            Frame.Size = UDim2.new(1,-10,0,50)
            Frame.BackgroundColor3 = UILib.Theme.Element
            Instance.new("UICorner", Frame)

            local Label = Instance.new("TextLabel", Frame)
            Label.Size = UDim2.new(1,-10,0,20)
            Label.Position = UDim2.fromOffset(5,0)
            Label.BackgroundTransparency = 1
            Label.TextXAlignment = Left
            Label.Font = Enum.Font.Gotham
            Label.TextSize = 12
            Label.TextColor3 = UILib.Theme.Text

            local Bar = Instance.new("Frame", Frame)
            Bar.Position = UDim2.fromOffset(5,28)
            Bar.Size = UDim2.new(1,-10,0,6)
            Bar.BackgroundColor3 = Color3.fromRGB(60,60,60)
            Instance.new("UICorner", Bar)

            local Fill = Instance.new("Frame", Bar)
            Fill.BackgroundColor3 = UILib.Theme.Accent
            Instance.new("UICorner", Fill)

            local function set(v)
                UILib.Flags[cfg.Flag] = math.clamp(v, cfg.Min, cfg.Max)
                local pct = (UILib.Flags[cfg.Flag]-cfg.Min)/(cfg.Max-cfg.Min)
                Fill.Size = UDim2.fromScale(pct,1)
                Label.Text = cfg.Text .. ": " .. UILib.Flags[cfg.Flag]
                if cfg.Callback then cfg.Callback(UILib.Flags[cfg.Flag]) end
            end
            set(UILib.Flags[cfg.Flag])

            Bar.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then
                    local move
                    move = UIS.InputChanged:Connect(function(m)
                        if m.UserInputType == Enum.UserInputType.MouseMovement then
                            local pct = math.clamp((m.Position.X - Bar.AbsolutePosition.X)/Bar.AbsoluteSize.X,0,1)
                            set(math.floor(cfg.Min + (cfg.Max-cfg.Min)*pct))
                        end
                    end)
                    UIS.InputEnded:Once(function() if move then move:Disconnect() end end)
                end
            end)
        end

        function Tab:AddKeybind(cfg)
            UILib.Flags[cfg.Flag] = cfg.DefaultKey

            UIS.InputBegan:Connect(function(i,gp)
                if not gp and i.KeyCode == UILib.Flags[cfg.Flag] then
                    if cfg.Callback then cfg.Callback() end
                end
            end)
        end

        return Tab
    end

    return Window
end

--====================================================
-- RAYFIELD STYLE WRAPPER (OPTIONAL)
--====================================================
UILib.Rayfield = {}

function UILib.Rayfield:CreateWindow(cfg)
    return UILib:CreateWindow(cfg)
end

return UILib
